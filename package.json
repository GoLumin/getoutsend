  "description": "Astro integration for getoutsend: one configured sender, a virtual:getoutsend client, and a dev outbox so nothing is ever sent from a development server.",
  "keywords": [
    "astro-integration",
    "astro-component",
    "email",
    "withastro"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
