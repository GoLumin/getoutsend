    "./pages/*": "./src/pages/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "astro": ">=6"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "astro": "^7.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
